<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenProbe.Core\TokenProbe.Core.csproj" />
    <ProjectReference Include="..\TokenProbe.Wpf\TokenProbe.Wpf.csproj" />
    <ProjectReference Include="..\TokenProbe.FakeProbe\TokenProbe.FakeProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The fake CLI stands in for tokenprobe.exe so the process contract can be
       exercised without network access or real API keys. -->
  <Target Name="CopyFakeProbe" AfterTargets="Build">
    <PropertyGroup>
      <FakeProbeDirectory>$(MSBuildThisFileDirectory)..\TokenProbe.FakeProbe\bin\$(Configuration)\net10.0\</FakeProbeDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_FakeProbeFiles Include="$(FakeProbeDirectory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FakeProbeFiles)"
          DestinationFiles="@(_FakeProbeFiles->'$(OutDir)fake\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(FakeProbeDirectory)')" />
  </Target>

</Project>