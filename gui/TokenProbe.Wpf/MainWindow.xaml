<Window x:Class="TokenProbe.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenProbe · 额度探测"
        Height="620"
        Width="860"
        MinHeight="480"
        MinWidth="640"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== navigation rail ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource NavBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                Width="{Binding NavigationWidth}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                    <TextBlock Text="TP"
                               FontWeight="SemiBold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="TokenProbe"
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,-6,0,10"
                               FontSize="11"
                               Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibility}}" />

                    <Button Command="{Binding ShowQuotaPageCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuotaPage}" Value="True">
                                        <Setter Property="Background" Value="#EAF1FF" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="¥" FontFamily="Segoe UI Symbol" Width="20" TextAlignment="Center" />
                            <TextBlock Text="额度"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSettingsPageCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="#EAF1FF" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" Width="20" TextAlignment="Center" />
                            <TextBlock Text="设置"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button DockPanel.Dock="Bottom"
                        Command="{Binding ToggleNavigationCommand}"
                        Margin="6,6,6,10"
                        AutomationProperties.Name="展开或收起导航">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </Button.Style>
                    <TextBlock Text="☰" FontFamily="Segoe UI Symbol" FontSize="14" />
                </Button>
            </DockPanel>
        </Border>

        <!-- ===== content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- quota page -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,24,24,8"
                          Visibility="{Binding IsQuotaPage, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="额度查询" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="读取厂商的剩余余额、周期花费与配额" Style="{StaticResource Muted}" Margin="0,2,0,0" />

                    <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="查询对象" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="厂商" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Providers}"
                                          SelectedItem="{Binding SelectedProvider}"
                                          DisplayMemberPath="DisplayName"
                                          Padding="6,4" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding QueryKeyHintText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <Button Content="去配置"
                                            Command="{Binding ShowSettingsPageCommand}"
                                            Style="{StaticResource LinkButton}"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding ShowGoToSettings, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="查询额度"
                                Command="{Binding QueryCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="120" />
                        <Button Content="取消"
                                Command="{Binding QueryCancelCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="90"
                                Margin="10,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <Border Style="{StaticResource CardBorder}"
                            BorderBrush="{StaticResource WarningBrush}"
                            Background="#FFF8EC"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                    </Border>

                    <Border Style="{StaticResource CardBorder}"
                            BorderBrush="#F0C2BE"
                            Background="#FFF5F4"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="查询失败" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#5F1B14" />
                            <Button Content="去配置页更换密钥"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsCredentialError, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding CapabilitiesText}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>

                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12" />

                            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding KindText}" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding AmountText}"
                                                           FontFamily="Consolas, Cascadia Mono"
                                                           FontSize="14"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding PeriodText}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="该厂商本次没有返回任何指标。" Margin="0,12,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metrics.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Result.Note}" Margin="0,12,0,0" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Result.Note}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- settings page -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,24,24,8"
                          Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="配置厂商的 API Key，并查看诊断信息" Style="{StaticResource Muted}" Margin="0,2,0,0" />

                    <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="API Key" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="正在配置" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Providers}"
                                          SelectedItem="{Binding ConfiguredProvider}"
                                          DisplayMemberPath="DisplayName"
                                          Padding="6,4" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding KeyStatusText}"
                                           Style="{StaticResource Muted}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"
                                           FontSize="12" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="密钥" VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <PasswordBox x:Name="KeyBox"
                                                 Padding="6,5"
                                                 PasswordChanged="KeyBox_OnPasswordChanged" />
                                    <TextBlock Text="{Binding KeyPlaceholderText}"
                                               IsHitTestVisible="False"
                                               Margin="9,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#9CA3AF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=KeyBox, Path=Password}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=KeyBox, Path=IsKeyboardFocusWithin}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="2"
                                        Content="校验并保存"
                                        Command="{Binding ValidateAndSaveCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="12,0,0,0" />
                                <Button Grid.Column="3"
                                        Content="取消"
                                        Command="{Binding ValidateAndSaveCancelCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="10,0,0,0"
                                        Visibility="{Binding IsValidating, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>

                            <TextBlock Text="{Binding KeySuccessMessage}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="90,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasKeySuccess, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBlock Text="{Binding KeyErrorMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="90,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasKeyError, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBlock Text="密钥仅在本机加密保存；校验通过后才会写入。"
                                       Style="{StaticResource Muted}"
                                       Margin="90,10,0,0"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="诊断" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="遇到问题时，到 GitHub 提交 issue，并附上日志目录中最新的日志文件。"
                                       Style="{StaticResource Muted}"
                                       Margin="0,8,0,0"
                                       FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="报告问题（GitHub）"
                                        Command="{Binding OpenIssueCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Content="打开日志文件夹"
                                        Command="{Binding OpenLogFolderCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding LogDirectory}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,10,0,0"
                                       FontSize="11" />
                            <TextBlock Text="{Binding ExecutableStatusText}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- status bar -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,8">
                <Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               Text="{Binding CliVersionText, StringFormat='CLI {0}'}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
